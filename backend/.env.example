# Copy to backend/.env and fill in. Every value is optional.

# ── LLM (free tiers). The first key present is primary, the rest are fallbacks. ──
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Tried next if the main Groq model fails ("off" disables it)
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Local OpenAI-compatible server for development (llama-cpp-python, Ollama, LM Studio). "off" disables it.
LOCAL_LLM_URL=http://localhost:8001/v1
# auto = tool-calling agent with a hosted model, guided pipeline with a local one. Or force: tools | guided
AGENT_MODE=auto

# ── API ──
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Optional: also allow origins matching a regex, e.g. Vercel preview URLs
# ALLOWED_ORIGIN_REGEX=https://finsage-[a-z0-9-]+\.vercel\.app
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=150
